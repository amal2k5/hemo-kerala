# HemoKerala environment variables
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control.

APP_NAME=HemoKerala
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=hemo_kerala

# Optional: overrides the URL assembled from the POSTGRES_* values above
# DATABASE_URL=postgresql+psycopg2://postgres:change_me_in_production@localhost:5432/hemo_kerala

# JWT
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
